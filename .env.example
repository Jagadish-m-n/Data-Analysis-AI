# Copy this file to .env and fill in your keys:
#
#     cp .env.example .env              (macOS / Linux)
#     Copy-Item .env.example .env       (Windows PowerShell)
#
# Required: the API key of LLM_PROVIDER (GROQ_API_KEY or GEMINI_API_KEY) and LANGSMITH_API_KEY.
# Everything else below is set to its default and can be left as it is.
# Keep comments on their own lines: `docker run --env-file` would read a trailing comment as
# part of the value.

# --- Which LLM runs the agent ---
# groq or gemini
LLM_PROVIDER=groq
# Model to switch to when the main one fails, as provider:model,
# e.g. gemini:gemini-3.5-flash-lite. Empty = no fallback.
LLM_FALLBACK=

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Seconds one call may take
GROQ_TIMEOUT=90
# Only for reasoning models (gpt-oss, qwen3); leave empty for other models
GROQ_REASONING_EFFORT=low

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Seconds one call may take (at least 10)
GEMINI_TIMEOUT=90

# --- LangSmith: runs the code sandboxes (https://smith.langchain.com/) ---
LANGSMITH_API_KEY=
# Send traces of each agent run to LangSmith. Read from the process environment only:
# works with `docker run --env-file .env` or `uv run --env-file .env main.py`
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=data-analysis-ai
# Seconds to wait for a new sandbox
SANDBOX_CREATE_TIMEOUT=120
# websocket, or sse (plain HTTPS) when a proxy / firewall blocks WebSockets
SANDBOX_TRANSPORT=websocket
# Snapshot new sandboxes boot from, with the data libraries pre-installed.
# `uv run python -m scripts.build_snapshot` writes its id here. Empty = the default image.
SANDBOX_SNAPSHOT=

# --- Application ---
APP_NAME=Data Analysis AI
APP_ENV=development
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# If set, clients must send it in the X-API-Key header. Empty = no login (fine on localhost only)
API_AUTH_KEY=

# --- Limits ---
ENABLE_AI_AGENT=true
# Model + tool calls before the agent is stopped
MAX_AGENT_ITERATIONS=40
# Older messages are summarized above this size
CONTEXT_MAX_TOKENS=5000
# Longer script output is saved to a file instead
TOOL_OUTPUT_MAX_TOKENS=1000
MAX_QUESTION_CHARS=2000
MAX_UPLOAD_FILES=10
MAX_UPLOAD_MB=50
# Questions per client IP per minute, 0 = no limit
RATE_LIMIT_PER_MINUTE=5
